# Gmail SMTP Configuration for inquiry emails
# Create an App Password at: https://myaccount.google.com/apppasswords
# (Requires 2-Factor Authentication to be enabled on the Gmail account)

GMAIL_USER=podovidoo@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Optional: Override admin email if different from GMAIL_USER
# ADMIN_EMAIL=podovidoo@gmail.com

# App / analytics
NEXT_PUBLIC_BASE_URL=https://www.podovi.online
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for storage uploads and server-side admin scripts
SUPABASE_SERVICE_ROLE_KEY=

# Optional helpers for scripts that talk to the Supabase Management API
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_PROJECT_NAME=podovi

# Legacy /api/ops credential fallback only; these do not enable /crm.
# CRM_BASIC_AUTH_USERNAME=
# CRM_BASIC_AUTH_PASSWORD=

# Required for /api/ops internal endpoints.
# If OPS_* values are omitted, the ops routes are disabled.
# OPS actorId defaults to OPS_BASIC_AUTH_USERNAME unless explicitly overridden.
# OPS_BASIC_AUTH_USERNAME=ops
# OPS_BASIC_AUTH_PASSWORD=change-me
# OPS_BASIC_AUTH_ACTOR_ID=ops-admin
