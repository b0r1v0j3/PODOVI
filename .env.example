# Gmail SMTP Configuration for inquiry emails
# Create an App Password at: https://myaccount.google.com/apppasswords
# (Requires 2-Factor Authentication to be enabled on the Gmail account)

GMAIL_USER=podovidoo@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Optional: Override admin email if different from GMAIL_USER
# ADMIN_EMAIL=podovidoo@gmail.com

# App / analytics
NEXT_PUBLIC_BASE_URL=https://www.podovi.online
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for internal CRM reads and server-side inquiry admin operations
SUPABASE_SERVICE_ROLE_KEY=

# Optional helpers for scripts that talk to the Supabase Management API
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_PROJECT_NAME=podovi

# Optional: Protect /crm with HTTP Basic Auth
# CRM_BASIC_AUTH_USERNAME=crm
# CRM_BASIC_AUTH_PASSWORD=change-me

# Required for /api/ops internal endpoints.
# If OPS_* values are omitted, the ops routes are disabled.
# OPS actorId defaults to OPS_BASIC_AUTH_USERNAME unless explicitly overridden.
# OPS_BASIC_AUTH_USERNAME=ops
# OPS_BASIC_AUTH_PASSWORD=change-me
# OPS_BASIC_AUTH_ACTOR_ID=ops-admin

# =============================================
# /cenovnik — zaštićena stranica za unos cena (dobavljač)
# =============================================
# Pristupni podaci koje dobija Tatjana (default: podovi / online)
# CENOVNIK_USER=podovi
# CENOVNIK_PASS=online
# Tajna za potpisivanje kolačića sesije (preporuka: postaviti nasumičnu vrednost)
# CENOVNIK_COOKIE_SECRET=
# PDV stopa (opciono; "20" ili "0.2"; default 20%)
# NEXT_PUBLIC_CENOVNIK_VAT_RATE=20

# Resend — slanje mejlova SA podovi@konzorcijum.com (domen verifikovan na Resend-u)
# RESEND_API_KEY=
# CENOVNIK_FROM_EMAIL=podovi@konzorcijum.com
# Adresa na koju stiže obaveštenje o novom unosu (default: ADMIN_EMAIL/GMAIL_USER)
# CENOVNIK_NOTIFY_EMAIL=
